{
  "name": "rusthinq-adapter",
  "type": "module",
  "description": "Runs rethink's LG ThinQ device converters and Home Assistant bridge against rusthinq's raw wire-frame MQTT bus, so rusthinq doesn't need its own per-device handlers.",
  "dependencies": {
    "express": "^4.22.1",
    "fast-xml-parser": "^5.3.3",
    "mqtt": "^5.3.0",
    "mqtt-connection": "^4.1.0",
    "mqtt-packet": "6.10.0",
    "strip-json-comments": "^5.0.3",
    "tiny-typed-emitter": "^2.1.0"
  },
  "engines": {
    "node": ">=16.0.0 <18.0.0 || >=20.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "prettier": "^3.8.3",
    "pretty-quick": "^4.2.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "predev": "node scripts/check-rethink.mjs",
    "dev": "tsx rusthinq-adapter.ts",
    "serve": "tsx scripts/run.mjs",
    "prebuild": "node scripts/check-rethink.mjs",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/rusthinq-adapter.js",
    "format": "npx prettier . --write",
    "postinstall": "node scripts/install-git-hooks.mjs && node scripts/check-rethink.mjs",
    "pretest": "node scripts/check-rethink.mjs",
    "test": "node --import tsx --test --test-reporter=spec $(find tests -name '*.test.ts')"
  },
  "simple-git-hooks": {
    "pre-commit": "npx pretty-quick --staged"
  }
}
