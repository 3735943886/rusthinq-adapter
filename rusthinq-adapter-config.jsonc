{
  // Same shape as config.jsonc's "homeassistant" block - this process still talks to Home
  // Assistant exactly as rethink-cloud.ts always has.
  "homeassistant": {
    "mqtt_url": "mqtt://localhost:1883",
    "discovery_prefix": "homeassistant",
    "rethink_prefix": "rethink", // distinct from rusthinq's own rusthinq_prefix - no topic collision
    "mqtt_user": "",
    "mqtt_pass": ""
    // "storage_path": "./ha-state"
  },

  // 0.1: MQTT is the default when transport is omitted.
  // 0.2: replace this block with { "transport": "management",
  //   "api_url": "http://rusthinq:8080/", "user": "adapter",
  //   "password": "your-password", "skip_ids": [] }.
  // Omit both user and password if the management API has no authentication.
  "rusthinq": {
    "mqtt_url": "mqtt://localhost:1883",
    "mqtt_user": "",
    "mqtt_pass": "",
    "rusthinq_prefix": "rusthinq", // rusthinq's [mqtt] rusthinq_prefix
    "raw_prefix": "rusthinq-raw", // rusthinq's [mqtt] raw_prefix - must be set there, along with raw = ["rx", "inject", "inject_clip"]
    "skip_ids": [] // device ids this adapter leaves alone (e.g. ones a rusthinq .rhai script drives instead)
  },

  "bridge": {
    "storage_path": "./state"
  },

  "log": ["status"]
}
